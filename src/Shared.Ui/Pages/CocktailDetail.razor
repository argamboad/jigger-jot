@page "/cocktails/{Id:guid}"
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Nav
@inject IStringLocalizer<AppStrings> Localizer

<PageTitle>@(_recipe?.Name ?? Localizer["Nav_Cocktails"])</PageTitle>

<a class="btn btn-link px-0 mb-2 recipe-back" href="/cocktails">← @Localizer["Nav_Cocktails"]</a>

@if (_loading)
{
    <div class="p-4 text-center text-muted">
        <span class="spinner-border spinner-border-sm me-2"></span> @Localizer["Common_Loading"]
    </div>
}
else if (_notFound)
{
    @* BACKBAR-4 (page 10): not found keeps its copy on the empty-state layout — her scene, the line,
       and a link back to the catalog — rather than a yellow alert. *@
    <div class="catalog-empty" data-testid="cocktail-notfound">
        <img src="_content/JiggerJot.Shared.Ui/brand/marga_scene_512.png"
             alt="" aria-hidden="true" class="empty-scene" width="512" height="512" />
        <p class="catalog-empty-line font-display">@Localizer["Cocktail_NotFound"]</p>
        <a class="btn btn-outline-secondary" href="/cocktails">← @Localizer["Nav_Cocktails"]</a>
    </div>
}
else if (_error is not null)
{
    <div class="alert alert-danger py-2" data-testid="cocktail-error">@_error</div>
}
else if (_recipe is not null)
{
    @* BACKBAR-4, handoff pages 09–10. The title in the serif, wrapping to two lines before it
       shrinks and never truncated; the status as a pill beside the facets; provenance IN the facet
       line, because it is metadata about the copy, not a headline. *@
    <div class="recipe">
        <header class="recipe-head">
            <h1 class="recipe-title font-display" data-testid="cocktail-name">
                @_recipe.Name
                @if (_recipe.IsOwn)
                {
                    <span class="badge text-bg-primary recipe-yours">@Localizer["Cocktails_Yours"]</span>
                }
            </h1>

            @* FEATURES §12: the detail view indicates where this drink stands against the shelf.
               Derived at query time by the API and never stored (JJ-003, JJ-019) — this only paints
               the answer. Further-away is neutral, never red: it is not an error (page 10). *@
            <p class="recipe-status">
                <span class="badge @MakeabilityClass" data-testid="cocktail-makeability">@Localizer[MakeabilityLabel]</span>
            </p>

            @* Glass and method are optional (JJ-034). When a recipe never said, the item is simply
               absent — no "unknown", which would read as a fact about the drink rather than a gap in
               the book. FORK-1's provenance rides here too: a copy says what it was BASED ON; it
               does not claim the book wrote it (JJ-013), and the link goes once the original is
               deleted, because it is not a foreign key. *@
            @if (Facets().Any() || _recipe.ForkedFrom is not null)
            {
                <p class="recipe-facets" data-testid="cocktail-facets">
                    @string.Join(" · ", Facets())
                    @if (_recipe.ForkedFrom is { } origin)
                    {
                        @if (Facets().Any())
                        {
                            <span aria-hidden="true"> · </span>
                        }
                        <span data-testid="cocktail-forked-from">
                            @Localizer["Cocktail_BasedOn"] <a href="/cocktails/@origin.Id">@origin.Name</a>
                        </span>
                    }
                </p>
            }

            @* MARGA-1, proposal screen 3. A substitution is the reason this drink qualified at all,
               so she says it once at the top as a recommendation. The line-level "(you'd pour X)"
               marker stays — that one answers WHICH line, and this one answers WHY the drink is
               here. MARGA-5 widened this: she used to appear ONLY when a substitution was in play,
               which meant she only ever turned up to explain a compromise — never to say yes. Her
               rule is unchanged (substitution outranks status, then Makeable / AlmostMakeable,
               silence beyond that); BACKBAR-4 only sets her line at 26px in the serif rather than as
               a caption, at 72 (page 02). *@
            @if (RecipeLine is { } margaLine)
            {
                <div class="recipe-marga" data-testid="cocktail-marga">
                    <MargaSays Tone="MargaTone.Card" Size="72">@margaLine</MargaSays>
                </div>
            }
        </header>

        <div class="recipe-grid">
            <section class="recipe-ingredients">
                <span class="eyebrow mb-2">@Localizer["Cocktail_Ingredients"]</span>
                @* Amounts lead (page 09): the measure in the serif at 21px and copper, in a 104px
                   column — on a recipe the quantity is the thing you scan. Already rendered in the
                   reader's preferred system by the API, so there is one implementation of that
                   arithmetic rather than one per client. *@
                <ul class="recipe-lines" data-testid="cocktail-lines">
                    @foreach (var line in _recipe.Lines)
                    {
                        <li class="recipe-line @(line.IsRequired ? null : "recipe-line-optional")">
                            <span class="recipe-amount font-display">@(string.IsNullOrWhiteSpace(line.Display) ? "—" : line.Display)</span>
                            <span class="recipe-ingredient">
                                @line.Ingredient
                                @if (!line.IsRequired)
                                {
                                    @* Plain text, not a badge (page 10): a garnish is just an
                                       optional line, and a chip on it made it look like a status. *@
                                    <span class="recipe-optional">@Localizer["Cocktail_Optional"]</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(line.Notes))
                                {
                                    <span class="recipe-notes">· @line.Notes</span>
                                }
                                @* Two marks only. A line the household can pour as written says
                                   nothing, because marking every line would turn a recipe into a
                                   checklist and bury the one line that needs attention. An optional
                                   line that is missing says nothing either: it never blocks (JJ-009),
                                   so it has nothing to ask for. *@
                                @if (line.Availability == "Substitute" && line.SubstituteWith is { } pour)
                                {
                                    <span class="recipe-mark recipe-mark-substitute" data-testid="cocktail-line-substitute">
                                        @Localizer["Cocktail_YoudPour", pour]
                                    </span>
                                }
                                else if (line.IsRequired && line.Availability == "Missing")
                                {
                                    <span class="recipe-mark recipe-mark-missing" data-testid="cocktail-line-missing">
                                        @Localizer["Cocktail_LineMissing"]
                                    </span>
                                }
                            </span>
                        </li>
                    }
                </ul>

                @* FEATURES §13: from ANY cocktail, including one you already forked — a household may
                   well want a second version. A primary pill at the foot of the ingredient column on
                   desktop; a fixed bar above the tab bar on a phone (page 10). Hidden in print. *@
                <div class="recipe-fork">
                    <button class="btn btn-primary" data-testid="cocktail-fork"
                            disabled="@_forking" @onclick="ForkAsync">@Localizer["Cocktail_Fork"]</button>
                    @if (_forkError is not null)
                    {
                        <div class="recipe-fork-error" data-testid="cocktail-fork-error">@_forkError</div>
                    }
                </div>
            </section>

            <aside class="recipe-aside">
                @if (!string.IsNullOrWhiteSpace(_recipe.Instructions))
                {
                    <section class="recipe-method">
                        <span class="eyebrow mb-2">@Localizer["Cocktail_Method"]</span>
                        <p class="recipe-instructions" data-testid="cocktail-instructions">@_recipe.Instructions</p>
                    </section>
                }

                @if (_recipe.Source is not null)
                {
                    @* The credit rides with the row rather than living in a footer, which is the whole
                       reason RecipeSource exists (JJ-032). *@
                    <p class="recipe-source" data-testid="cocktail-source">
                        @_recipe.Source.Name@(_recipe.Source.Year is { } y ? $" ({y})" : "")
                        @if (!string.IsNullOrWhiteSpace(_recipe.Source.Attribution))
                        {
                            <span aria-hidden="true"> · </span>

                            @_recipe.Source.Attribution
                        }
                    </p>
                }
            </aside>
        </div>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private CocktailDetailView? _recipe;
    private bool _loading = true;
    private bool _notFound;
    private string? _error;
    private bool _forking;
    private string? _forkError;

    // OnParametersSetAsync rather than OnInitializedAsync: Blazor reuses the component when the route
    // parameter changes, so initialising once would leave the old recipe on screen.
    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _notFound = false;
        _error = null;

        try
        {
            var response = await Http.GetAsync($"/api/cocktails/{Id}");
            if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                _notFound = true;
                return;
            }

            response.EnsureSuccessStatusCode();
            _recipe = await response.Content.ReadFromJsonAsync<CocktailDetailView>();
        }
        catch (Exception)
        {
            _error = Localizer["Cocktails_LoadFailed"];
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>
    /// Copies this recipe into the household and opens the copy. Landing on the fork rather than
    /// staying here is the point: the button exists because someone wants to change something, and
    /// leaving them looking at the original would be the one screen where they cannot.
    /// </summary>
    private async Task ForkAsync()
    {
        _forking = true;
        _forkError = null;

        try
        {
            var response = await Http.PostAsync($"/api/cocktails/{Id}/fork", null);
            response.EnsureSuccessStatusCode();

            var created = await response.Content.ReadFromJsonAsync<ForkedView>();
            if (created is null) return;

            Nav.NavigateTo($"/cocktails/{created.Id}");
        }
        catch (Exception)
        {
            _forkError = Localizer["Cocktail_ForkFailed"];
        }
        finally
        {
            _forking = false;
        }
    }

    /// <summary>
    /// The lines this household would pour something else for (MARGA-1). The API already decided
    /// which those are; this only reads them back so her card and the per-line markers can never
    /// disagree about the same recipe.
    /// </summary>
    private List<LineView> Swaps => _recipe is null
        ? []
        : [.. _recipe.Lines.Where(l => l.Availability == "Substitute" && l.SubstituteWith is not null)];

    /// <summary>
    /// What she says about this recipe, or null when there is nothing worth saying (MARGA-5).
    /// </summary>
    /// <remarks>
    /// A substitution outranks everything: it is the reason the drink qualified at all, and leaving
    /// it unsaid would have her congratulate someone on a drink they cannot pour as written. After
    /// that it follows the same status the badge does — so the two can never disagree, because they
    /// read the one value the API derived.
    /// <para>
    /// She says nothing at all about a drink that is more than one bottle away. The badge has already
    /// said so plainly, and a character adding "you cannot make this" to it is piling on.
    /// </para>
    /// </remarks>
    private string? RecipeLine
    {
        get
        {
            if (Swaps.Count > 0)
                return string.Join(" ", Swaps.Select(l => Localizer["Marga_Swap", l.Ingredient, l.SubstituteWith!].Value));

            return _recipe?.Makeability switch
            {
                "Makeable" => Localizer["Marga_RecipeMakeable"].Value,
                "AlmostMakeable" when MissingLine is { } missing => Localizer["Marga_RecipeOneAway", missing].Value,
                _ => null,
            };
        }
    }

    /// <summary>The single line standing between this household and this drink, when there is one.</summary>
    private string? MissingLine => _recipe?.Lines
        .FirstOrDefault(l => l.IsRequired && l.Availability == "Missing")?.Ingredient;

    /// <summary>
    /// The wording and the colour both key off the status the API derived. Switching on it here
    /// rather than sending a colour keeps the presentation on this side of the boundary, where a
    /// second front end can disagree about the badge without disagreeing about the drink.
    /// </summary>
    private string MakeabilityLabel => _recipe?.Makeability switch
    {
        "Makeable" => "Cocktail_Makeable",
        "AlmostMakeable" => "Cocktail_AlmostMakeable",
        _ => "Cocktail_NotMakeable",
    };

    private string MakeabilityClass => _recipe?.Makeability switch
    {
        "Makeable" => "text-bg-success",
        "AlmostMakeable" => "text-bg-warning",
        _ => "text-bg-secondary",
    };

    private IEnumerable<string> Facets()
    {
        if (_recipe is null) yield break;
        if (!string.IsNullOrWhiteSpace(_recipe.Glass)) yield return _recipe.Glass!;
        if (!string.IsNullOrWhiteSpace(_recipe.Method)) yield return _recipe.Method!;
    }

    private record CocktailDetailView(
        Guid Id, string Name, string? Glass, string? Method, string ServingType,
        string? Instructions, SourceView? Source, bool IsOwn, IReadOnlyList<LineView> Lines,
        string Makeability, ForkOriginViewModel? ForkedFrom);

    private record ForkOriginViewModel(Guid Id, string Name);

    private record ForkedView(Guid Id);

    private record SourceView(string Name, int? Year, string? Url, string? Attribution);

    private record LineView(
        string Ingredient, decimal? Amount, string? Unit, string Display,
        bool IsRequired, string Role, string? Notes,
        string Availability, string? SubstituteWith);
}
