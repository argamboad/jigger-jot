@page "/cocktails/{Id:guid}"
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Nav
@inject IStringLocalizer<AppStrings> Localizer

<PageTitle>@(_recipe?.Name ?? Localizer["Nav_Cocktails"])</PageTitle>

<a class="btn btn-link px-0 mb-2" href="/cocktails">← @Localizer["Nav_Cocktails"]</a>

@if (_loading)
{
    <div class="p-4 text-center text-muted">
        <span class="spinner-border spinner-border-sm me-2"></span> @Localizer["Common_Loading"]
    </div>
}
else if (_notFound)
{
    <div class="alert alert-warning py-2" data-testid="cocktail-notfound">@Localizer["Cocktail_NotFound"]</div>
}
else if (_error is not null)
{
    <div class="alert alert-danger py-2" data-testid="cocktail-error">@_error</div>
}
else if (_recipe is not null)
{
    <h1 class="h4 fw-bold mb-1" data-testid="cocktail-name">
        @_recipe.Name
        @if (_recipe.IsOwn)
        {
            <span class="badge text-bg-primary align-middle ms-2">@Localizer["Cocktails_Yours"]</span>
        }
    </h1>

    @* Glass and method are optional (JJ-034). When a recipe never said, the line is simply absent —
       no "unknown", which would read as a fact about the drink rather than a gap in the book. *@
    @if (Facets().Any())
    {
        <p class="text-muted mb-2" data-testid="cocktail-facets">@string.Join(" · ", Facets())</p>
    }

    @* FEATURES §12: the detail view indicates where this drink stands against the shelf. Derived at
       query time by the API and never stored (JJ-003, JJ-019) — this only paints the answer. *@
    <p class="mb-2">
        <span class="badge @MakeabilityClass" data-testid="cocktail-makeability">@Localizer[MakeabilityLabel]</span>
    </p>

    @* FORK-1: provenance, not credit (JJ-013). A copy says what it was based on; it does not claim
       the book wrote it. Absent once the original is deleted, because the link is not a foreign key. *@
    @if (_recipe.ForkedFrom is { } origin)
    {
        <p class="text-muted small mb-4" data-testid="cocktail-forked-from">
            @Localizer["Cocktail_BasedOn"] <a href="/cocktails/@origin.Id">@origin.Name</a>
        </p>
    }
    else
    {
        <div class="mb-4"></div>
    }

    @* MARGA-1, proposal screen 3. A substitution is the reason this drink qualified at all, so she
       says it once at the top as a recommendation. The line-level "(you'd pour X)" marker stays —
       that one answers WHICH line, and this one answers WHY the drink is here. *@
    @if (Swaps.Count > 0)
    {
        <div class="card shadow-sm mb-3" data-testid="cocktail-marga">
            <div class="card-body py-3">
                <MargaSays Size="44">
                    @string.Join(" ", Swaps.Select(l => Localizer["Marga_Swap", l.Ingredient, l.SubstituteWith!].Value))
                </MargaSays>
            </div>
        </div>
    }

    <div class="mb-3">
        @* FEATURES §13: from ANY cocktail, including one you already forked — a household may well
           want a second version. *@
        <button class="btn btn-outline-primary btn-sm" data-testid="cocktail-fork"
                disabled="@_forking" @onclick="ForkAsync">@Localizer["Cocktail_Fork"]</button>
        @if (_forkError is not null)
        {
            <span class="text-danger small ms-2" data-testid="cocktail-fork-error">@_forkError</span>
        }
    </div>

    <div class="card shadow-sm mb-3">
        <div class="card-body">
            <h2 class="h6 text-uppercase text-muted mb-3">@Localizer["Cocktail_Ingredients"]</h2>
            <ul class="list-unstyled mb-0" data-testid="cocktail-lines">
                @foreach (var line in _recipe.Lines)
                {
                    <li class="d-flex gap-3 py-1 border-bottom">
                        @* The amount is already rendered in the reader's preferred system by the API,
                           so there is one implementation of that arithmetic rather than one per client. *@
                        <span class="text-nowrap fw-medium" style="min-width:6rem">@line.Display</span>
                        <span>
                            @line.Ingredient
                            @if (!line.IsRequired)
                            {
                                <span class="badge text-bg-light ms-1">@Localizer["Cocktail_Optional"]</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(line.Notes))
                            {
                                <span class="text-muted small ms-1">@line.Notes</span>
                            }
                            @* Only the two answers worth saying out loud. A line the household can
                               pour as written says nothing, because marking every line would turn a
                               recipe into a checklist and bury the one line that needs attention. *@
                            @* Parenthesised rather than merely spaced: Razor collapses the whitespace
                               between an expression and the next element, which ran the ingredient
                               and its mark together into one word on the page and in a screen
                               reader. The brackets also read as the aside this is. *@
                            @if (line.Availability == "Substitute" && line.SubstituteWith is { } pour)
                            {
                                <span class="small text-warning-emphasis ms-2" data-testid="cocktail-line-substitute">
                                    (@Localizer["Cocktail_YoudPour", pour])
                                </span>
                            }
                            else if (line.Availability == "Missing")
                            {
                                <span class="small text-danger-emphasis ms-2" data-testid="cocktail-line-missing">
                                    (@Localizer["Cocktail_LineMissing"])
                                </span>
                            }
                        </span>
                    </li>
                }
            </ul>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_recipe.Instructions))
    {
        <div class="card shadow-sm mb-3">
            <div class="card-body">
                <h2 class="h6 text-uppercase text-muted mb-2">@Localizer["Cocktail_Method"]</h2>
                <p class="mb-0" data-testid="cocktail-instructions">@_recipe.Instructions</p>
            </div>
        </div>
    }

    @if (_recipe.Source is not null)
    {
        @* The credit rides with the row rather than living in a footer, which is the whole reason
           RecipeSource exists (JJ-032). *@
        <p class="text-muted small" data-testid="cocktail-source">
            @_recipe.Source.Name@(_recipe.Source.Year is { } y ? $" ({y})" : "")
            @if (!string.IsNullOrWhiteSpace(_recipe.Source.Attribution))
            {
                <br />

                @_recipe.Source.Attribution
            }
        </p>
    }
}

@code {
    [Parameter] public Guid Id { get; set; }

    private CocktailDetailView? _recipe;
    private bool _loading = true;
    private bool _notFound;
    private string? _error;
    private bool _forking;
    private string? _forkError;

    // OnParametersSetAsync rather than OnInitializedAsync: Blazor reuses the component when the route
    // parameter changes, so initialising once would leave the old recipe on screen.
    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _notFound = false;
        _error = null;

        try
        {
            var response = await Http.GetAsync($"/api/cocktails/{Id}");
            if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                _notFound = true;
                return;
            }

            response.EnsureSuccessStatusCode();
            _recipe = await response.Content.ReadFromJsonAsync<CocktailDetailView>();
        }
        catch (Exception)
        {
            _error = Localizer["Cocktails_LoadFailed"];
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>
    /// Copies this recipe into the household and opens the copy. Landing on the fork rather than
    /// staying here is the point: the button exists because someone wants to change something, and
    /// leaving them looking at the original would be the one screen where they cannot.
    /// </summary>
    private async Task ForkAsync()
    {
        _forking = true;
        _forkError = null;

        try
        {
            var response = await Http.PostAsync($"/api/cocktails/{Id}/fork", null);
            response.EnsureSuccessStatusCode();

            var created = await response.Content.ReadFromJsonAsync<ForkedView>();
            if (created is null) return;

            Nav.NavigateTo($"/cocktails/{created.Id}");
        }
        catch (Exception)
        {
            _forkError = Localizer["Cocktail_ForkFailed"];
        }
        finally
        {
            _forking = false;
        }
    }

    /// <summary>
    /// The lines this household would pour something else for (MARGA-1). The API already decided
    /// which those are; this only reads them back so her card and the per-line markers can never
    /// disagree about the same recipe.
    /// </summary>
    private List<LineView> Swaps => _recipe is null
        ? []
        : [.. _recipe.Lines.Where(l => l.Availability == "Substitute" && l.SubstituteWith is not null)];

    /// <summary>
    /// The wording and the colour both key off the status the API derived. Switching on it here
    /// rather than sending a colour keeps the presentation on this side of the boundary, where a
    /// second front end can disagree about the badge without disagreeing about the drink.
    /// </summary>
    private string MakeabilityLabel => _recipe?.Makeability switch
    {
        "Makeable" => "Cocktail_Makeable",
        "AlmostMakeable" => "Cocktail_AlmostMakeable",
        _ => "Cocktail_NotMakeable",
    };

    private string MakeabilityClass => _recipe?.Makeability switch
    {
        "Makeable" => "text-bg-success",
        "AlmostMakeable" => "text-bg-warning",
        _ => "text-bg-secondary",
    };

    private IEnumerable<string> Facets()
    {
        if (_recipe is null) yield break;
        if (!string.IsNullOrWhiteSpace(_recipe.Glass)) yield return _recipe.Glass!;
        if (!string.IsNullOrWhiteSpace(_recipe.Method)) yield return _recipe.Method!;
    }

    private record CocktailDetailView(
        Guid Id, string Name, string? Glass, string? Method, string ServingType,
        string? Instructions, SourceView? Source, bool IsOwn, IReadOnlyList<LineView> Lines,
        string Makeability, ForkOriginViewModel? ForkedFrom);

    private record ForkOriginViewModel(Guid Id, string Name);

    private record ForkedView(Guid Id);

    private record SourceView(string Name, int? Year, string? Url, string? Attribution);

    private record LineView(
        string Ingredient, decimal? Amount, string? Unit, string Display,
        bool IsRequired, string Role, string? Notes,
        string Availability, string? SubstituteWith);
}
