@page "/billing"
@page "/billing/success"
@page "/billing/cancel"
@using System.Net.Http.Json
@using System.Text.Json.Serialization
@implements IDisposable
@inject AuthService Auth
@inject HttpClient Http
@inject NavigationManager Nav
@inject AppResumeNotifier Resume
@inject IStringLocalizer<AppStrings> Localizer

<PageTitle>@Localizer["Billing_Title"]</PageTitle>

@* BACKBAR-8 (JJ-039): not drawn in the handoff, restyled to the same language as Settings — two
   labelled groups, Plan and Seats, the plan name in the serif with its status as a pill in the
   status colours, the checkout notices as one 12px notice, the owner-only pointer a muted line. Same
   calls, same gate (GATES-1 hides the whole page when billing is off), same ids. *@
<div class="billing-wrapper">
    <h1 class="page-title mb-1">@Localizer["Billing_Title"]</h1>
    <p class="text-muted mb-4">@Localizer["Billing_Subtitle"]</p>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger py-2" data-testid="billing-error">@_error</div>
    }

    @* The hosted checkout returns the user to /billing/success or /billing/cancel — this page, with a word about what happened. *@
    @if (_checkout == "success")
    {
        <div class="notice mb-3" data-testid="billing-checkout-success">@Localizer["Billing_CheckoutSuccess"]</div>
    }
    else if (_checkout == "cancel")
    {
        <div class="notice notice-muted mb-3" data-testid="billing-checkout-cancel">@Localizer["Billing_CheckoutCancelled"]</div>
    }

    @if (_loading)
    {
        <div class="p-4 text-center text-muted">
            <span class="spinner-border spinner-border-sm me-2"></span> @Localizer["Common_Loading"]
        </div>
    }
    else if (_forbidden)
    {
        @* Billing is owner-only (Permission.ManageBilling) — members get a friendly pointer. *@
        <p class="settings-group-hint" data-testid="billing-owner-only">@Localizer["Billing_OwnerOnly"]</p>
    }
    else if (_summary is not null)
    {
        <div class="settings-grid">
            <section class="settings-group">
                <span class="eyebrow">@Localizer["Billing_CurrentPlan"]</span>
                <div class="settings-group-head">
                    <p class="billing-plan font-display text-capitalize" data-testid="billing-plan">@Label($"Plan_{_summary.PlanKey}", _summary.PlanKey)</p>
                    <span class="badge @StatusClass" data-testid="billing-status">@Label($"BillingStatus_{_summary.Status}", _summary.Status)</span>
                </div>
                @* A cancelled subscription's period end is the day it ENDED — never "renews" next to a free plan. *@
                @if (_summary.CurrentPeriodEnd is { } end)
                {
                    if (_summary.Status == CanceledStatus)
                    {
                        <p class="settings-row-meta mb-3" data-testid="billing-ended">@Localizer["Billing_EndedOn", end.LocalDateTime.ToString("d")]</p>
                    }
                    else
                    {
                        <p class="settings-row-meta mb-3" data-testid="billing-renews">@Localizer["Billing_RenewsOn", end.LocalDateTime.ToString("d")]</p>
                    }
                }

                <div class="d-flex align-items-center gap-3">
                    @if (_summary.PlanKey == FreePlanKey)
                    {
                        <button class="btn btn-primary" data-testid="billing-upgrade" disabled="@_busy" @onclick="Upgrade">
                            @if (_busy)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            @Localizer["Billing_Upgrade"]
                        </button>
                    }
                    @* No portal for a cancelled subscription: there is nothing live to manage (and the provider customer may be
                       gone); Upgrade is the way back — it opens a fresh checkout. *@
                    @if (_summary.HasSubscription && _summary.Status != CanceledStatus)
                    {
                        <button class="btn btn-link px-0" data-testid="billing-portal" disabled="@_busy" @onclick="OpenPortal">@Localizer["Billing_Manage"]</button>
                    }
                </div>
            </section>

            <section class="settings-group">
                <span class="eyebrow">@Localizer["Billing_Seats"]</span>
                @* The same n-of-m figure the shelf uses, in the serif and copper. *@
                <p class="shelf-payoff-count font-display mt-2" data-testid="billing-seats">@Localizer["Billing_SeatsUsage", _summary.Seats.Used, _summary.Seats.Limit?.ToString() ?? "∞"]</p>
            </section>
        </div>
    }
</div>

@code {
    // Localize a plan/status token via its "Plan_{key}" / "BillingStatus_{status}" resource, falling back
    // to the raw token when there's no string for it — so the money page never renders bare machine tokens
    // for known values, and an unmapped one degrades to the (capitalized) token instead of a missing key
    // (v3 UX-5).
    private string Label(string key, string fallback)
    {
        var s = Localizer[key];
        return s.ResourceNotFound ? fallback : s.Value;
    }

    // Plan keys mirror src/Core/Billing/PlanCatalog.cs (EXAMPLE plans — retune per app with the catalog).
    private const string FreePlanKey = "free";
    private const string UpgradePlanKey = "pro";
    private const string CanceledStatus = "canceled";

    // BACKBAR-8: the status pill in the app's status colours (handoff page 10), not info-blue. A live
    // subscription is the "good" state, one that is ending or behind is the warning, anything else
    // (none, free) is neutral — never red; it is not an error.
    private string StatusClass => _summary?.Status switch
    {
        "active" or "trialing" => "bg-success-subtle text-success-emphasis",
        "past_due" or CanceledStatus => "bg-warning-subtle text-warning-emphasis",
        _ => "bg-secondary-subtle text-secondary-emphasis",
    };

    /// <summary>"success" | "cancel" when the page is the provider's return address; null on a plain visit.</summary>
    private string? _checkout;
    private bool _disposed;
    /// <summary>How long to wait before refetching after a successful checkout (the webhook lands a moment after the redirect). Tests shorten it.</summary>
    [Parameter] public int RefreshDelayMs { get; set; } = 3000;

    private bool _loading = true;
    private bool _forbidden;
    private bool _busy;
    private string? _error;
    private SummaryDto? _summary;

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsAuthenticated)
        {
            Nav.NavigateTo("/login");
            return;
        }
        // GATES-1 (ADR-027): with billing off the API has no /api/billing routes, so this page could only
        // ever render errors. Leave before it renders anything — the link is hidden too, so arriving here
        // means a bookmark or a typed URL.
        if (!await Auth.IsBillingEnabledAsync())
        {
            Nav.NavigateTo("/");
            return;
        }
        // On native, checkout/portal open the system browser and the provider's redirect lands on
        // web — this page is still what the user returns to. Refresh on resume so the new plan
        // shows without a manual re-navigation (NATIVE-4, G2). Never fires on web.
        Resume.Resumed += OnAppResumed;
        var path = new Uri(Nav.Uri).AbsolutePath.TrimEnd('/');
        _checkout = path.EndsWith("/billing/success", StringComparison.OrdinalIgnoreCase) ? "success"
            : path.EndsWith("/billing/cancel", StringComparison.OrdinalIgnoreCase) ? "cancel" : null;
        await LoadAsync();
        if (_checkout == "success") _ = RefreshAfterCheckoutAsync();
    }

    /// <summary>
    /// After a successful checkout the plan flips when the provider's webhook lands — usually seconds after the
    /// redirect, sometimes before it. Refetch a couple of times (quietly, no spinner) so the page catches up on
    /// its own instead of asking the user to reload.
    /// </summary>
    private async Task RefreshAfterCheckoutAsync()
    {
        for (var attempt = 0; attempt < 2 && !_disposed && _summary?.PlanKey == FreePlanKey; attempt++)
        {
            await Task.Delay(RefreshDelayMs);
            if (_disposed) return;
            try { await InvokeAsync(async () => { await LoadAsync(quiet: true); StateHasChanged(); }); }
            catch (ObjectDisposedException) { return; }
        }
    }

    private void OnAppResumed() => _ = InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    public void Dispose()
    {
        _disposed = true;
        Resume.Resumed -= OnAppResumed;
    }

    private async Task LoadAsync(bool quiet = false)
    {
        if (!quiet) _loading = true;
        try
        {
            var res = await Http.GetAsync("/api/billing");
            if (res.StatusCode == System.Net.HttpStatusCode.Forbidden)
            {
                _forbidden = true;
                return;
            }
            res.EnsureSuccessStatusCode();
            _summary = await res.Content.ReadFromJsonAsync<SummaryDto>();
        }
        catch { _error = Localizer["Billing_ErrLoad"]; }
        finally { _loading = false; }
    }

    private async Task Upgrade()
    {
        _busy = true; _error = null;
        try
        {
            var res = await Http.PostAsJsonAsync("/api/billing/checkout", new { plan_key = UpgradePlanKey });
            if (res.IsSuccessStatusCode)
            {
                var body = await res.Content.ReadFromJsonAsync<UrlDto>();
                if (!string.IsNullOrEmpty(body?.Url))
                {
                    // Hosted checkout is an external page — full navigation, the provider redirects back.
                    Nav.NavigateTo(body.Url, forceLoad: true);
                    return;
                }
            }
            _error = Localizer["Billing_ErrCheckout"];
        }
        catch { _error = Localizer["Billing_ErrCheckout"]; }
        finally { _busy = false; }
    }

    private async Task OpenPortal()
    {
        _busy = true; _error = null;
        try
        {
            var res = await Http.PostAsync("/api/billing/portal", null);
            if (res.IsSuccessStatusCode)
            {
                var body = await res.Content.ReadFromJsonAsync<UrlDto>();
                if (!string.IsNullOrEmpty(body?.Url))
                {
                    Nav.NavigateTo(body.Url, forceLoad: true);
                    return;
                }
            }
            _error = Localizer["Billing_ErrPortal"];
        }
        catch { _error = Localizer["Billing_ErrPortal"]; }
        finally { _busy = false; }
    }

    private sealed record SummaryDto
    {
        [JsonPropertyName("plan_key")] public string PlanKey { get; init; } = "free";
        [JsonPropertyName("status")] public string Status { get; init; } = "none";
        [JsonPropertyName("current_period_end")] public DateTimeOffset? CurrentPeriodEnd { get; init; }
        [JsonPropertyName("seats")] public SeatsDto Seats { get; init; } = new();
        [JsonPropertyName("has_subscription")] public bool HasSubscription { get; init; }
    }

    private sealed record SeatsDto
    {
        [JsonPropertyName("used")] public int Used { get; init; }
        [JsonPropertyName("limit")] public int? Limit { get; init; }
    }

    private sealed record UrlDto
    {
        [JsonPropertyName("url")] public string? Url { get; init; }
    }
}
