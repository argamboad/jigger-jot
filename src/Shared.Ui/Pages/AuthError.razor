@page "/auth-error"
@inject IStringLocalizer<AppStrings> Localizer

<PageTitle>@Localizer["AuthError_Title"]</PageTitle>

@* BACKBAR-5 (page 06): the login split, with her line replaced by the error copy — so it has no
   attribution label, because it is not her line. Chromeless, like login. *@
<div class="auth-error">
    <MargaSplit Line="@Localizer["AuthError_Heading"]" Compact="true">
        <img src="_content/JiggerJot.Shared.Ui/brand/lockup_light_1520.png" alt="JiggerJot" class="login-lockup mb-4" />
        <h1 class="page-title mb-2">@Localizer["AuthError_Heading"]</h1>
        <p class="text-muted mb-4" style="max-width:42ch">
            @Localizer["AuthError_Body"]
        </p>
        <a href="/login" class="btn btn-primary">@Localizer["AuthError_BackToSignIn"]</a>
    </MargaSplit>
</div>
