@page "/auth-callback"
@inject AuthService Auth
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IStringLocalizer<AppStrings> Localizer

<PageTitle>@Localizer["AuthCallback_Processing"]</PageTitle>

@* BACKBAR-8: the 2px brass bar the other screens use while they wait, instead of a spinner. *@
<div class="auth-callback" role="status">
    <span class="loading-bar" aria-hidden="true"></span>
    <p class="text-muted mt-4 text-center">@Localizer["AuthCallback_Processing"]</p>
</div>

@code {
    // Restored 2026-09-14. The restyle above replaced the whole file and this block went with the
    // spinner, so every web sign-in — OTP, magic link, OAuth — stopped here on "Processing sign-in…".
    // The page had no test of its own; AuthCallbackTests now holds it.
    protected override async Task OnInitializedAsync()
    {
        // MainLayout already ran InitializeAsync (the single refresh), so by now we're
        // usually authenticated. Fall back to a refresh only if not.
        var ok = Auth.IsAuthenticated || await Auth.TryRefreshAsync();

        if (!ok)
        {
            Nav.NavigateTo("/auth-error", replace: true);
            return;
        }

        // Honor a pending post-login redirect (e.g. an invite being accepted).
        // Only same-origin relative paths are allowed — guards against open redirects.
        var redirect = await JS.InvokeAsync<string?>("localStorage.getItem", "post_login_redirect");
        await JS.InvokeVoidAsync("localStorage.removeItem", "post_login_redirect");

        if (!string.IsNullOrWhiteSpace(redirect) && redirect.StartsWith('/') && !redirect.StartsWith("//"))
            Nav.NavigateTo(redirect, replace: true);
        else
            Nav.NavigateTo("/", replace: true);
    }
}

