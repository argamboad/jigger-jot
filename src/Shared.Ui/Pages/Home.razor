@page "/"
@using System.Net.Http.Json
@using JiggerJot.Shared.Ui.Auth
@inject HttpClient Http
@inject AuthService Auth
@inject IStringLocalizer<AppStrings> Localizer

<PageTitle>@Localizer["Nav_Home"]</PageTitle>

@if (Auth.IsAuthenticated)
{
    @* MARGA-2, proposal screen 1. This replaced an inherited platform welcome card whose only
       app-specific content was `<!-- TODO -->`. The count is the headline because it IS the product's
       question answered; Marga states the one purchase that extends it. *@
    <div class="home-wrapper">

        @if (_loading)
        {
            <div class="p-5 text-center text-muted">
                <span class="spinner-border spinner-border-sm me-2"></span> @Localizer["Common_Loading"]
            </div>
        }
        else
        {
            <div class="card shadow-sm mb-3" data-testid="home-marga">
                <div class="card-body p-4">
                    <MargaSays Size="56" Aside="@Localizer["Marga_HomeAside"]">
                        @MargaLine
                    </MargaSays>
                </div>
            </div>

            @if (_makeable is { Total: > 0 })
            {
                <div class="card shadow-sm mb-3">
                    <div class="card-body p-4">
                        <p class="home-count mb-0" data-testid="home-count">@_makeable.Total</p>
                        <p class="text-body-secondary mb-3">@Localizer["Home_MakeableLabel"]</p>

                        <div class="d-flex flex-wrap gap-2 mb-3">
                            @* Deep-linked, so the button lands on the list that produced the number
                               above it rather than on the whole catalog. *@
                            <a class="btn btn-primary" href="/cocktails?makeable=true" data-testid="home-show-makeable">
                                @Localizer["Home_ShowMakeable"]
                            </a>
                            <a class="btn btn-outline-secondary" href="/shelf" data-testid="home-update-shelf">
                                @Localizer["Home_UpdateShelf"]
                            </a>
                        </div>

                        <ul class="list-group list-group-flush" data-testid="home-makeable-list">
                            @foreach (var c in _makeable.Items)
                            {
                                <li class="list-group-item px-0">
                                    <a class="text-decoration-none fw-medium" href="/cocktails/@c.Id">@c.Name</a>
                                    <div class="text-muted small">@string.Join(" · ", Facets(c))</div>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            }
            else
            {
                @* Not the catalog's empty state — that one is MARGA-3. This is the front page telling
                   a household with nothing ticked where to start. *@
                <div class="card shadow-sm mb-3">
                    <div class="card-body p-4 text-center">
                        <a class="btn btn-primary btn-lg" href="/shelf" data-testid="home-update-shelf">
                            @Localizer["Make_FillYourShelf"]
                        </a>
                    </div>
                </div>
            }

            @if (_bottle is not null)
            {
                <div class="card shadow-sm border-primary-subtle bg-primary-subtle" data-testid="home-unlocks">
                    <div class="card-body p-4">
                        <p class="fw-medium mb-1">@Localizer["Cocktails_UnlocksHeadline", _bottle.Ingredient, _bottle.Unlocks]</p>
                        <p class="text-body-secondary small mb-3">@Named(_bottle.Cocktails)</p>
                        <a class="btn btn-outline-primary btn-sm" href="/cocktails?almost=true" data-testid="home-show-almost">
                            @Localizer["Home_ShowAlmost"]
                        </a>
                    </div>
                </div>
            }
        }
    </div>
}
else
{
    <div class="welcome-wrapper">
        <div class="hero-section text-center">
            <img src="_content/JiggerJot.Shared.Ui/brand/lockup_light_1520.png" alt="JiggerJot"
                 class="welcome-lockup mb-4" />
            <p class="lead text-muted mb-4 mx-auto" style="max-width:480px">
                @Localizer["Home_HeroSubtitle"]
            </p>
            <a href="/login" class="btn btn-primary btn-lg px-5">@Localizer["Home_SignInCta"] &rarr;</a>
        </div>
    </div>
}

@code {
    private const int Preview = 3;

    private PagedResponse<CocktailSummary>? _makeable;
    private UnlockView? _bottle;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsAuthenticated)
        {
            _loading = false;
            return;
        }

        try
        {
            // TWO calls, each internally consistent, and that is the rule this screen turns on.
            // The headline count and the three drinks under it come from ONE response, so they can
            // never disagree; the bottle and the drinks it opens come from another, where the count
            // is the length of the names by construction (ALMOST-2). Her sentence quotes one number
            // from each, and each half agrees with the list beneath it.
            _makeable = await Http.GetFromJsonAsync<PagedResponse<CocktailSummary>>(
                $"/api/cocktails?makeable=true&page=1&pageSize={Preview}");

            var bottles = await Http.GetFromJsonAsync<List<UnlockView>>("/api/cocktails/unlocks?limit=1");
            _bottle = bottles is { Count: > 0 } ? bottles[0] : null;
        }
        catch (Exception)
        {
            // She is optional furniture: if the data behind her line is not there, the screen renders
            // without her rather than with an empty speech bubble.
            _makeable = null;
            _bottle = null;
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>
    /// Which of her three fixed lines this household gets. She never assembles a sentence from
    /// fragments — this picks one whole resource string and fills its placeholders.
    /// </summary>
    private string MargaLine => (_makeable?.Total ?? 0, _bottle) switch
    {
        (0, _) => Localizer["Marga_HomeEmpty"],
        (_, { } bottle) => Localizer["Marga_HomeBottle", bottle.Ingredient, bottle.Unlocks],
        _ => Localizer["Marga_HomeNoBottle"],
    };

    /// <summary>
    /// The drinks a bottle opens, trimmed for reading. On a real shelf the top bottle named thirteen,
    /// which is a wall rather than a list — so the DISPLAY stops at four and counts the rest. The data
    /// stays whole: `unlocks` is the length of the names, and truncating those would break the number
    /// shown beside them.
    /// </summary>
    private string Named(IReadOnlyList<string> cocktails)
    {
        const int shown = 4;
        if (cocktails.Count <= shown) return string.Join(" · ", cocktails);
        return string.Join(" · ", cocktails.Take(shown))
               + " · " + Localizer["Cocktails_UnlocksMore", cocktails.Count - shown];
    }

    private IEnumerable<string> Facets(CocktailSummary c)
    {
        if (!string.IsNullOrWhiteSpace(c.Glass)) yield return c.Glass!;
        if (!string.IsNullOrWhiteSpace(c.Method)) yield return c.Method!;
        yield return Localizer["Cocktails_IngredientCount", c.IngredientCount];
    }

    private record PagedResponse<T>(IReadOnlyList<T> Items, int Page, int PageSize, int Total);

    private record CocktailSummary(
        Guid Id, string Name, string? Glass, string? Method,
        string ServingType, string? Source, bool IsOwn, int IngredientCount,
        IReadOnlyList<SubstitutionInPlay> Substitutions, string? MissingIngredient);

    private record SubstitutionInPlay(string AsksFor, string YouHave);

    private record UnlockView(Guid IngredientId, string Ingredient, int Unlocks, List<string> Cocktails);
}
