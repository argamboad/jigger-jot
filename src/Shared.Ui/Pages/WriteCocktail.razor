@page "/cocktails/new"
@page "/cocktails/{Id:guid}/edit"
@using System.Net
@using System.Net.Http.Json
@using System.Globalization
@inject HttpClient Http
@inject NavigationManager Nav
@inject IStringLocalizer<AppStrings> Localizer

@* AUTHORING-2: one page for writing a cocktail and for editing one the household owns. Editing fills the
   same form from the draft, saves with a PUT, and returns to the recipe. *@
<PageTitle>@Localizer[Editing ? "Cocktail_Edit" : "Cocktail_New"]</PageTitle>

<a class="btn btn-link px-0 mb-2" href="@(Editing ? $"/cocktails/{Id}" : "/cocktails")">← @Localizer[Editing ? "Cocktail_BackToRecipe" : "Nav_Cocktails"]</a>

<h1 class="page-title mb-1">@Localizer[Editing ? "Cocktail_Edit" : "Cocktail_New"]</h1>
<p class="text-muted mb-4">@Localizer[Editing ? "Cocktail_EditSubtitle" : "Cocktail_NewSubtitle"]</p>

@if (_loading)
{
    <div class="p-4 text-center text-muted">
        <span class="spinner-border spinner-border-sm me-2"></span> @Localizer["Common_Loading"]
    </div>
}
else if (_editBlocked is not null)
{
    @* A shared catalog recipe is read-only (JJ-002), and one that is not here cannot be edited. Say
       which, and offer the way back rather than an empty form that would only fail on Save. *@
    <div class="notice" data-testid="edit-read-only">
        @Localizer[_editBlocked]
        <a href="/cocktails/@Id">@Localizer["Cocktail_BackToRecipe"]</a>
    </div>
}
else
{
    @* MARGA-6 (JJ-040): the page's voice, over the bottles this household ticked — the inventory the
       form already loads for its ingredient picker, so no request of her own. Her promise ("I will tell
       you whether you can pour it") is kept by the recipe page, which now speaks in every case. Absent
       when the shelf could not be read, rather than claiming a count of nothing. *@
    @if (_shelfKnown)
    {
        <div class="write-marga mb-4" data-testid="new-marga">
            <MargaSays Tone="MargaTone.Card" Size="72">@(ShelfBottles > 0
                ? Localizer["Marga_WriteShelf", ShelfBottles]
                : Localizer["Marga_WriteEmpty"])</MargaSays>
        </div>
    }

    @* BACKBAR-6 (handoff page 15): two columns, not one long form — the drink on the left, its
       ingredients on the right; one column on a phone with Save as a bar above the tab bar. No
       cards. Errors attach to the field they belong to; new-error keeps its place above Save for
       the server's answer. *@
    <div class="write-grid">
        <section class="write-drink">
            <span class="eyebrow mb-3">@Localizer["Cocktail_FieldName"]</span>
            <div class="write-fields">
                <div>
                    <label class="form-label small mb-1" for="new-name">@Localizer["Cocktail_FieldName"]</label>
                    <input class="form-control @(_nameError ? "is-invalid" : null)" id="new-name" data-testid="new-name" @bind="_name" />
                    @if (_nameError)
                    {
                        <div class="invalid-feedback">@Localizer["Cocktail_ErrName"]</div>
                    }
                </div>
                <div>
                    <label class="form-label small mb-1" for="new-serving">@Localizer["Cocktail_FieldServing"]</label>
                    <select class="form-select" id="new-serving" data-testid="new-serving" @bind="_serving">
                        @foreach (var s in _options.ServingTypes)
                        {
                            <option value="@s">@Localizer[$"Cocktails_Serving{s}"]</option>
                        }
                    </select>
                </div>

                @* Both optional, and meant to stay that way (JJ-034): a quarter of the seeded catalog
                   never states a glass, and someone writing down what they actually pour should not
                   have to invent one. *@
                <div class="write-fields-pair">
                    <div>
                        <label class="form-label small mb-1" for="new-glass">@Localizer["Cocktail_FieldGlass"]</label>
                        <select class="form-select" id="new-glass" data-testid="new-glass" @bind="_glass">
                            <option value="">@Localizer["Cocktail_NotStated"]</option>
                            @foreach (var g in _options.Glasses)
                            {
                                <option value="@g.Id">@g.Name</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="form-label small mb-1" for="new-method">@Localizer["Cocktail_FieldMethod"]</label>
                        <select class="form-select" id="new-method" data-testid="new-method" @bind="_method">
                            <option value="">@Localizer["Cocktail_NotStated"]</option>
                            @foreach (var m in _options.Methods)
                            {
                                <option value="@m.Id">@m.Name</option>
                            }
                        </select>
                    </div>
                </div>

                <div>
                    <label class="form-label small mb-1" for="new-instructions">@Localizer["Cocktail_FieldInstructions"]</label>
                    <textarea class="form-control" id="new-instructions" rows="4"
                              data-testid="new-instructions" @bind="_instructions"></textarea>
                </div>
            </div>
        </section>

        <section class="write-lines">
            <div class="write-lines-head">
                <span class="eyebrow">@Localizer["Cocktail_Ingredients"]</span>
                <span class="write-lines-count">@Localizer["Cocktails_IngredientCount", _lines.Count]</span>
            </div>

            <div data-testid="new-lines">
                @foreach (var line in _lines)
                {
                    @* One row per line: the amount and its unit lead, in the display face so the
                       form previews the recipe it is writing; the ingredient, with its role and
                       required as a visible sub-line — no popover (JJ-036 F4) — and a remove control. *@
                    <div class="write-line" data-testid="new-line">
                        <div class="write-line-amount">
                            <input class="form-control font-display write-amount" data-testid="new-line-amount"
                                   aria-label="@Localizer["Cocktail_LineAmount"]"
                                   placeholder="0" @bind="line.Amount" />
                            <select class="form-select write-unit" data-testid="new-line-unit"
                                    aria-label="@Localizer["Cocktail_LineUnit"]" @bind="line.UnitId">
                                <option value="">—</option>
                                @foreach (var u in _options.Units)
                                {
                                    <option value="@u.Id">@u.Name</option>
                                }
                            </select>
                        </div>
                        <div class="write-line-main">
                            @* AUTHORING-4: a combobox rather than a select — two hundred bottles is a
                               scroll, not a picker. Type a name or a category to narrow it. The list is
                               everything this household can see: the shared catalog plus its own
                               additions from INV-2. AUTHORING-3: choosing the bottle fills in its role
                               and whether it is required, unless someone already set those by hand. *@
                            <IngredientPicker Options="_ingredientOptions" TestId="new-line-ingredient"
                                              AriaLabel="@Localizer["Cocktail_LineIngredient"]"
                                              Placeholder="@Localizer["Cocktail_LineIngredient"]"
                                              Value="@(Guid.TryParse(line.IngredientId, out var chosen) ? chosen : (Guid?)null)"
                                              ValueChanged="(Guid? picked) => PickIngredientAsync(line, picked)" />
                            <div class="write-line-sub">
                                <select class="form-select form-select-sm write-role" data-testid="new-line-role"
                                        aria-label="@Localizer["Cocktail_LineRole"]"
                                        @bind="line.Role" @bind:after="() => line.RoleTouched = true">
                                    @foreach (var r in _options.Roles)
                                    {
                                        <option value="@r">@Localizer[$"Cocktail_Role{r}"]</option>
                                    }
                                </select>
                                @* A garnish is just an optional line, and optional lines never block
                                   makeability (JJ-009). *@
                                <div class="form-check form-check-inline mb-0">
                                    <input class="form-check-input" type="checkbox" data-testid="new-line-required"
                                           id="@($"req-{line.Key}")" @bind="line.IsRequired"
                                           @bind:after="() => line.RequiredTouched = true" />
                                    <label class="form-check-label small" for="@($"req-{line.Key}")">@Localizer["Cocktail_LineRequired"]</label>
                                </div>
                            </div>
                        </div>
                        <button class="btn btn-link write-line-remove" data-testid="new-line-remove"
                                aria-label="@Localizer["Household_Remove"]"
                                disabled="@(_lines.Count == 1)" @onclick="() => RemoveLineAsync(line)">×</button>
                    </div>
                }
            </div>

            @if (_linesError)
            {
                <p class="write-lines-error" data-testid="new-lines-error">@Localizer["Cocktail_ErrNoLines"]</p>
            }

            <button class="btn btn-outline-secondary btn-sm mt-3" data-testid="new-line-add"
                    @onclick="() => _lines.Add(new LineDraft())">+ @Localizer["Cocktail_AddLine"]</button>
        </section>
    </div>

    <div class="write-save">
        @if (_error is not null)
        {
            <div class="alert alert-warning py-2 mb-2" data-testid="new-error">@_error</div>
        }
        <button class="btn btn-primary" data-testid="new-save" disabled="@_saving" @onclick="SaveAsync">
            @Localizer["Cocktail_Save"]
        </button>
    </div>
}

@code {
    private bool _loading = true;
    private bool _saving;
    private string? _error;

    // BACKBAR-6: the two client-side checks attach to what they are about — the name field and the
    // lines — rather than to a summary alert at the top. `_error` is the server's answer, above Save.
    private bool _nameError;
    private bool _linesError;

    private string _name = string.Empty;
    private string _glass = string.Empty;
    private string _method = string.Empty;
    private string _serving = nameof(ServingKind.FullDrink);
    private string _instructions = string.Empty;

    private readonly List<LineDraft> _lines = [new LineDraft()];
    private OptionsView _options = new([], [], [], [], []);
    private List<ShelfItemView> _ingredients = [];

    // AUTHORING-4: the same bottles, shaped for the picker — by category, then name, for an empty search.
    private IReadOnlyList<IngredientOption> _ingredientOptions = [];

    // MARGA-6: whether the inventory actually came back, so a failed read does not become "nothing on
    // your shelf yet" — the SHELL/MARGA-5 lesson of a line she has nothing behind.
    private bool _shelfKnown;

    private int ShelfBottles => _ingredients.Count(i => i.IsAvailable);

    // AUTHORING-3: each ask gets a ticket, and an answer overtaken by a later ask is dropped — two
    // quick picks must not let the first answer land on top of the second.
    private int _roleTicket;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Two calls: the curated lookups a recipe may reference, and the ingredients this
            // household can actually see — the shared catalog plus its own (JJ-031).
            _options = await Http.GetFromJsonAsync<OptionsView>("/api/cocktails/lookups")
                       ?? new OptionsView([], [], [], [], []);
            _ingredients = await Http.GetFromJsonAsync<List<ShelfItemView>>("/api/inventory") ?? [];
            _ingredientOptions = [.. _ingredients
                .OrderBy(i => i.Category, StringComparer.OrdinalIgnoreCase)
                .ThenBy(i => i.Name, StringComparer.OrdinalIgnoreCase)
                .Select(i => new IngredientOption(i.Id, i.Name, i.Category, i.IsAvailable))];
            _shelfKnown = true;

            if (Editing) await LoadDraftAsync();
        }
        catch (Exception)
        {
            _error = Localizer["Cocktails_LoadFailed"];
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SaveAsync()
    {
        _error = null;

        // BACKBAR-6: both checks run, each marks its own field, and neither reaches the summary
        // alert — that one is for the server's answer.
        _nameError = string.IsNullOrWhiteSpace(_name);
        var lines = _lines.Where(l => Guid.TryParse(l.IngredientId, out _)).ToList();
        _linesError = lines.Count == 0;
        if (_nameError || _linesError) return;

        _saving = true;
        try
        {
            var recipe = new
            {
                name = _name.Trim(),
                glassTypeId = Guid.TryParse(_glass, out var glass) ? glass : (Guid?)null,
                methodId = Guid.TryParse(_method, out var method) ? method : (Guid?)null,
                servingType = _serving,
                instructions = string.IsNullOrWhiteSpace(_instructions) ? null : _instructions.Trim(),
                lines = lines.Select(l => new
                {
                    ingredientId = Guid.Parse(l.IngredientId),
                    amount = ParseAmount(l.Amount),
                    unitId = Guid.TryParse(l.UnitId, out var unit) ? unit : (Guid?)null,
                    isRequired = l.IsRequired,
                    role = l.Role,
                    // Carried through, so editing a line never quietly drops the note it came with.
                    notes = l.Notes,
                }),
            };

            // AUTHORING-2: the same body either way — a PUT to the cocktail when editing it.
            var response = Editing
                ? await Http.PutAsJsonAsync($"/api/cocktails/{Id}", recipe)
                : await Http.PostAsJsonAsync("/api/cocktails", recipe);

            if (!response.IsSuccessStatusCode)
            {
                // The API's codes are the ones with the reasoning behind them; the page just gives
                // each one a sentence someone can act on.
                var problem = await response.Content.ReadFromJsonAsync<ErrorView>();
                _error = problem?.Error switch
                {
                    "invalid_name" => Localizer["Cocktail_ErrName"],
                    "no_lines" => Localizer["Cocktail_ErrNoLines"],
                    "unknown_ingredient" => Localizer["Cocktail_ErrIngredient"],
                    "invalid_line" => Localizer["Cocktail_ErrLine"],
                    "catalog_read_only" => Localizer["Cocktail_ErrReadOnly"],
                    _ => Localizer["Cocktail_ErrLookup"],
                };
                return;
            }

            if (Editing)
            {
                Nav.NavigateTo($"/cocktails/{Id}");
                return;
            }

            var created = await response.Content.ReadFromJsonAsync<CreatedView>();
            if (created is not null) Nav.NavigateTo($"/cocktails/{created.Id}");
        }
        catch (Exception)
        {
            _error = Localizer["Cocktails_LoadFailed"];
        }
        finally
        {
            _saving = false;
        }
    }

    /// <summary>
    /// AUTHORING-3: asks the API what role each chosen ingredient should take and applies it to every
    /// line whose role — or required box — nobody has touched. The whole recipe is asked in order,
    /// because only the first spirit is the base: picking a second one changes nothing above it, and
    /// removing the first can promote the next. The rule is the server's (<c>RecipeRoles</c> in Core),
    /// so this page never re-derives it.
    /// </summary>
    private async Task SuggestRolesAsync()
    {
        var ticket = ++_roleTicket;
        var picked = _lines.Where(l => Guid.TryParse(l.IngredientId, out _)).ToList();
        if (picked.Count == 0) return;

        try
        {
            var query = string.Join("&", picked.Select(l => $"ingredient={l.IngredientId}"));
            var suggestions = await Http.GetFromJsonAsync<List<RoleSuggestionView>>($"/api/cocktails/roles?{query}");
            if (ticket != _roleTicket || suggestions is null || suggestions.Count != picked.Count) return;

            for (var i = 0; i < picked.Count; i++)
            {
                if (!picked[i].RoleTouched) picked[i].Role = suggestions[i].Role;
                if (!picked[i].RequiredTouched) picked[i].IsRequired = suggestions[i].IsRequired;
            }
        }
        catch (Exception)
        {
            // Only a suggestion: if it cannot be had, the lines keep whatever they already say.
        }
    }

    /// <summary>The cocktail being edited (AUTHORING-2); null when writing a new one.</summary>
    [Parameter] public Guid? Id { get; set; }

    private bool Editing => Id is not null;

    /// <summary>Why this cocktail cannot be edited — a resource key — or null when it can.</summary>
    private string? _editBlocked;

    /// <summary>
    /// Fills the form from the cocktail's draft, whose volumes are already in this writer's unit
    /// (JJ-041). Every line counts as set by hand, so the role suggestion (AUTHORING-3) never overwrites
    /// a role or required box the recipe already has.
    /// </summary>
    private async Task LoadDraftAsync()
    {
        var response = await Http.GetAsync($"/api/cocktails/{Id}/draft");
        if (response.StatusCode == HttpStatusCode.Forbidden)
        {
            _editBlocked = "Cocktail_ErrReadOnly";
            return;
        }
        if (!response.IsSuccessStatusCode)
        {
            _editBlocked = "Cocktail_EditMissing";
            return;
        }

        var draft = await response.Content.ReadFromJsonAsync<DraftView>();
        if (draft is null)
        {
            _editBlocked = "Cocktail_EditMissing";
            return;
        }

        _name = draft.Name;
        _glass = draft.GlassTypeId?.ToString() ?? string.Empty;
        _method = draft.MethodId?.ToString() ?? string.Empty;
        _serving = draft.ServingType;
        _instructions = draft.Instructions ?? string.Empty;

        _lines.Clear();
        _lines.AddRange(draft.Lines.Select(l => new LineDraft
        {
            IngredientId = l.IngredientId.ToString(),
            Amount = l.Amount?.ToString(CultureInfo.InvariantCulture),
            UnitId = l.UnitId?.ToString() ?? string.Empty,
            IsRequired = l.IsRequired,
            Role = l.Role,
            Notes = l.Notes,
            RoleTouched = true,
            RequiredTouched = true,
        }));
        if (_lines.Count == 0) _lines.Add(new LineDraft());
    }

    private async Task PickIngredientAsync(LineDraft line, Guid? picked)
    {
        line.IngredientId = picked?.ToString() ?? string.Empty;
        await SuggestRolesAsync();
    }

    private async Task RemoveLineAsync(LineDraft line)
    {
        _lines.Remove(line);
        await SuggestRolesAsync();
    }

    /// <summary>
    /// Invariant culture on purpose: this is a wire value, and a Spanish reader typing "22,5" means
    /// the same amount as an English one typing "22.5". Both are accepted and sent as one number.
    /// </summary>
    private static decimal? ParseAmount(string? text)
    {
        if (string.IsNullOrWhiteSpace(text)) return null;
        var normalised = text.Trim().Replace(',', '.');
        return decimal.TryParse(normalised, NumberStyles.Number, CultureInfo.InvariantCulture, out var value)
            ? value
            : null;
    }

    private enum ServingKind { Shot, FullDrink }

    private sealed class LineDraft
    {
        public Guid Key { get; } = Guid.CreateVersion7();
        public string IngredientId { get; set; } = string.Empty;
        public string? Amount { get; set; }
        public string UnitId { get; set; } = string.Empty;
        public bool IsRequired { get; set; } = true;
        public string Role { get; set; } = "Base";

        /// <summary>A line's note, carried from the draft so an edit keeps it (AUTHORING-2).</summary>
        public string? Notes { get; set; }

        /// <summary>Set by hand, so a suggestion never overwrites it (AUTHORING-3).</summary>
        public bool RoleTouched { get; set; }
        public bool RequiredTouched { get; set; }
    }

    private record RoleSuggestionView(Guid IngredientId, string Role, bool IsRequired);

    private record OptionView(Guid Id, string Name);

    private record OptionsView(
        List<OptionView> Glasses, List<OptionView> Methods, List<OptionView> Units,
        List<string> ServingTypes, List<string> Roles);

    private record ShelfItemView(
        Guid Id, string Name, string Category, string? Subcategory, bool IsAvailable, bool IsOwn);

    private record CreatedView(Guid Id);

    private record DraftView(
        Guid Id, string Name, Guid? GlassTypeId, Guid? MethodId, string ServingType, string? Instructions,
        List<DraftLineView> Lines);

    private record DraftLineView(
        Guid IngredientId, decimal? Amount, Guid? UnitId, bool IsRequired, string Role, string? Notes);

    private record ErrorView(string Error, string Message);
}
