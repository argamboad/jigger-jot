@page "/cocktails/new"
@using System.Net.Http.Json
@using System.Globalization
@inject HttpClient Http
@inject NavigationManager Nav
@inject IStringLocalizer<AppStrings> Localizer

<PageTitle>@Localizer["Cocktail_New"]</PageTitle>

<a class="btn btn-link px-0 mb-2" href="/cocktails">← @Localizer["Nav_Cocktails"]</a>

<h1 class="h4 fw-bold mb-1">@Localizer["Cocktail_New"]</h1>
<p class="text-muted mb-3">@Localizer["Cocktail_NewSubtitle"]</p>

@if (_loading)
{
    <div class="p-4 text-center text-muted">
        <span class="spinner-border spinner-border-sm me-2"></span> @Localizer["Common_Loading"]
    </div>
}
else
{
    <div class="card shadow-sm mb-3">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <label class="form-label small mb-1" for="new-name">@Localizer["Cocktail_FieldName"]</label>
                    <input class="form-control" id="new-name" data-testid="new-name" @bind="_name" />
                </div>
                <div class="col-12 col-md-6">
                    <label class="form-label small mb-1" for="new-serving">@Localizer["Cocktail_FieldServing"]</label>
                    <select class="form-select" id="new-serving" data-testid="new-serving" @bind="_serving">
                        @foreach (var s in _options.ServingTypes)
                        {
                            <option value="@s">@Localizer[$"Cocktails_Serving{s}"]</option>
                        }
                    </select>
                </div>

                @* Both optional, and meant to stay that way (JJ-034): a quarter of the seeded catalog
                   never states a glass, and someone writing down what they actually pour should not
                   have to invent one. *@
                <div class="col-12 col-md-6">
                    <label class="form-label small mb-1" for="new-glass">@Localizer["Cocktail_FieldGlass"]</label>
                    <select class="form-select" id="new-glass" data-testid="new-glass" @bind="_glass">
                        <option value="">@Localizer["Cocktail_NotStated"]</option>
                        @foreach (var g in _options.Glasses)
                        {
                            <option value="@g.Id">@g.Name</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md-6">
                    <label class="form-label small mb-1" for="new-method">@Localizer["Cocktail_FieldMethod"]</label>
                    <select class="form-select" id="new-method" data-testid="new-method" @bind="_method">
                        <option value="">@Localizer["Cocktail_NotStated"]</option>
                        @foreach (var m in _options.Methods)
                        {
                            <option value="@m.Id">@m.Name</option>
                        }
                    </select>
                </div>

                <div class="col-12">
                    <label class="form-label small mb-1" for="new-instructions">@Localizer["Cocktail_FieldInstructions"]</label>
                    <textarea class="form-control" id="new-instructions" rows="3"
                              data-testid="new-instructions" @bind="_instructions"></textarea>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-3">
        <div class="card-body">
            <h2 class="h6 text-uppercase text-muted mb-3">@Localizer["Cocktail_Ingredients"]</h2>

            <div data-testid="new-lines">
                @foreach (var line in _lines)
                {
                    <div class="row g-2 align-items-end mb-2 pb-2 border-bottom" data-testid="new-line">
                        <div class="col-12 col-md-4">
                            <label class="form-label small mb-1">@Localizer["Cocktail_LineIngredient"]</label>
                            @* Grouped by category, because a flat list of two hundred bottles is not
                               a picker. The list is everything this household can see — the shared
                               catalog plus its own additions from INV-2. *@
                            <select class="form-select" data-testid="new-line-ingredient" @bind="line.IngredientId">
                                <option value="">—</option>
                                @foreach (var group in _ingredients.GroupBy(i => i.Category))
                                {
                                    <optgroup label="@group.Key">
                                        @foreach (var i in group)
                                        {
                                            <option value="@i.Id">@i.Name</option>
                                        }
                                    </optgroup>
                                }
                            </select>
                        </div>
                        <div class="col-6 col-md-2">
                            <label class="form-label small mb-1">@Localizer["Cocktail_LineAmount"]</label>
                            <input class="form-control" data-testid="new-line-amount" @bind="line.Amount" />
                        </div>
                        <div class="col-6 col-md-2">
                            <label class="form-label small mb-1">@Localizer["Cocktail_LineUnit"]</label>
                            <select class="form-select" data-testid="new-line-unit" @bind="line.UnitId">
                                <option value="">—</option>
                                @foreach (var u in _options.Units)
                                {
                                    <option value="@u.Id">@u.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-6 col-md-2">
                            <label class="form-label small mb-1">@Localizer["Cocktail_LineRole"]</label>
                            <select class="form-select" data-testid="new-line-role" @bind="line.Role">
                                @foreach (var r in _options.Roles)
                                {
                                    <option value="@r">@Localizer[$"Cocktail_Role{r}"]</option>
                                }
                            </select>
                        </div>
                        <div class="col-6 col-md-2 d-flex align-items-center gap-3">
                            @* A garnish is just an optional line, and optional lines never block
                               makeability (JJ-009). *@
                            <div class="form-check mb-0">
                                <input class="form-check-input" type="checkbox" data-testid="new-line-required"
                                       id="@($"req-{line.Key}")" @bind="line.IsRequired" />
                                <label class="form-check-label small" for="@($"req-{line.Key}")">@Localizer["Cocktail_LineRequired"]</label>
                            </div>
                            <button class="btn btn-link btn-sm text-danger px-0" data-testid="new-line-remove"
                                    disabled="@(_lines.Count == 1)" @onclick="() => _lines.Remove(line)">×</button>
                        </div>
                    </div>
                }
            </div>

            <button class="btn btn-outline-secondary btn-sm mt-2" data-testid="new-line-add"
                    @onclick="() => _lines.Add(new LineDraft())">@Localizer["Cocktail_AddLine"]</button>
        </div>
    </div>

    @if (_error is not null)
    {
        <div class="alert alert-warning py-2" data-testid="new-error">@_error</div>
    }

    <button class="btn btn-primary" data-testid="new-save" disabled="@_saving" @onclick="SaveAsync">
        @Localizer["Cocktail_Save"]
    </button>
}

@code {
    private bool _loading = true;
    private bool _saving;
    private string? _error;

    private string _name = string.Empty;
    private string _glass = string.Empty;
    private string _method = string.Empty;
    private string _serving = nameof(ServingKind.FullDrink);
    private string _instructions = string.Empty;

    private readonly List<LineDraft> _lines = [new LineDraft()];
    private OptionsView _options = new([], [], [], [], []);
    private List<ShelfItemView> _ingredients = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Two calls: the curated lookups a recipe may reference, and the ingredients this
            // household can actually see — the shared catalog plus its own (JJ-031).
            _options = await Http.GetFromJsonAsync<OptionsView>("/api/cocktails/lookups")
                       ?? new OptionsView([], [], [], [], []);
            _ingredients = await Http.GetFromJsonAsync<List<ShelfItemView>>("/api/inventory") ?? [];
        }
        catch (Exception)
        {
            _error = Localizer["Cocktails_LoadFailed"];
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SaveAsync()
    {
        _error = null;

        if (string.IsNullOrWhiteSpace(_name))
        {
            _error = Localizer["Cocktail_ErrName"];
            return;
        }

        var lines = _lines.Where(l => Guid.TryParse(l.IngredientId, out _)).ToList();
        if (lines.Count == 0)
        {
            _error = Localizer["Cocktail_ErrNoLines"];
            return;
        }

        _saving = true;
        try
        {
            var response = await Http.PostAsJsonAsync("/api/cocktails", new
            {
                name = _name.Trim(),
                glassTypeId = Guid.TryParse(_glass, out var glass) ? glass : (Guid?)null,
                methodId = Guid.TryParse(_method, out var method) ? method : (Guid?)null,
                servingType = _serving,
                instructions = string.IsNullOrWhiteSpace(_instructions) ? null : _instructions.Trim(),
                lines = lines.Select(l => new
                {
                    ingredientId = Guid.Parse(l.IngredientId),
                    amount = ParseAmount(l.Amount),
                    unitId = Guid.TryParse(l.UnitId, out var unit) ? unit : (Guid?)null,
                    isRequired = l.IsRequired,
                    role = l.Role,
                    notes = (string?)null,
                }),
            });

            if (!response.IsSuccessStatusCode)
            {
                // The API's codes are the ones with the reasoning behind them; the page just gives
                // each one a sentence someone can act on.
                var problem = await response.Content.ReadFromJsonAsync<ErrorView>();
                _error = problem?.Error switch
                {
                    "invalid_name" => Localizer["Cocktail_ErrName"],
                    "no_lines" => Localizer["Cocktail_ErrNoLines"],
                    "unknown_ingredient" => Localizer["Cocktail_ErrIngredient"],
                    "invalid_line" => Localizer["Cocktail_ErrLine"],
                    _ => Localizer["Cocktail_ErrLookup"],
                };
                return;
            }

            var created = await response.Content.ReadFromJsonAsync<CreatedView>();
            if (created is not null) Nav.NavigateTo($"/cocktails/{created.Id}");
        }
        catch (Exception)
        {
            _error = Localizer["Cocktails_LoadFailed"];
        }
        finally
        {
            _saving = false;
        }
    }

    /// <summary>
    /// Invariant culture on purpose: this is a wire value, and a Spanish reader typing "22,5" means
    /// the same amount as an English one typing "22.5". Both are accepted and sent as one number.
    /// </summary>
    private static decimal? ParseAmount(string? text)
    {
        if (string.IsNullOrWhiteSpace(text)) return null;
        var normalised = text.Trim().Replace(',', '.');
        return decimal.TryParse(normalised, NumberStyles.Number, CultureInfo.InvariantCulture, out var value)
            ? value
            : null;
    }

    private enum ServingKind { Shot, FullDrink }

    private sealed class LineDraft
    {
        public Guid Key { get; } = Guid.CreateVersion7();
        public string IngredientId { get; set; } = string.Empty;
        public string? Amount { get; set; }
        public string UnitId { get; set; } = string.Empty;
        public bool IsRequired { get; set; } = true;
        public string Role { get; set; } = "Base";
    }

    private record OptionView(Guid Id, string Name);

    private record OptionsView(
        List<OptionView> Glasses, List<OptionView> Methods, List<OptionView> Units,
        List<string> ServingTypes, List<string> Roles);

    private record ShelfItemView(
        Guid Id, string Name, string Category, string? Subcategory, bool IsAvailable, bool IsOwn);

    private record CreatedView(Guid Id);

    private record ErrorView(string Error, string Message);
}
