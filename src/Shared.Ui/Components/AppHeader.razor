@using Microsoft.AspNetCore.Components.Routing
@using JiggerJot.Shared.Ui.Auth
@implements IDisposable
@inject AuthService Auth
@inject NavigationManager Nav
@inject IStringLocalizer<AppStrings> Localizer

<nav class="navbar navbar-expand-lg navbar-dark app-header">
    <div class="container-fluid">

        <a class="navbar-brand app-brand d-flex align-items-center gap-2" href="/">
            <!-- Brand mark from the RCL's static web assets (shared by Web + MAUI). -->
            <img src="_content/JiggerJot.Shared.Ui/brand/icon_light.svg" alt="" class="brand-icon" height="32" width="32" />
            <span class="brand-text">JiggerJot</span>
        </a>

        <!-- Hamburger: shown below the lg breakpoint (phones/tablets); Bootstrap hides it
             on wide screens. Toggled by Blazor state — the app doesn't load Bootstrap JS.
             SHELL-1 left it holding the ACCOUNT cluster only: the app's own destinations moved out
             of it and into the tab bar, which is the whole point of the slice. -->
        <button class="navbar-toggler" type="button" @onclick="ToggleMenu"
                aria-label="@Localizer["Nav_AccountMenu"]" aria-expanded="@_menuOpen.ToString().ToLowerInvariant()">
            <span class="navbar-toggler-icon"></span>
        </button>

        <!-- SHELL-1. The app's own screens, and ONE element at every width: in the header bar at lg
             and above, a fixed bottom tab bar below it. Rendering a second copy for narrow screens
             and hiding one with CSS would put two `nav-shelf` in the DOM, and the browser journeys
             that click it by test id would fail on an ambiguous locator — which is the single
             highest-risk detail in this epic, so the markup is arranged to make it impossible.

             Deliberately OUTSIDE the collapse: inside it, the tab bar would vanish below lg until
             someone opened the hamburger, which is exactly the trip this slice removes.

             The cluster on the right is the platform's account furniture (household, billing,
             settings, sign out) and reads as such. Shelf and Cocktails sat in that cluster until
             ALMOST-1, which put "what can I make" on the same footing as "cancel my subscription". -->
        <ul class="navbar-nav app-tabs me-auto ms-lg-4">
            <li class="nav-item">
                <NavLink class="nav-link" href="/" Match="NavLinkMatch.All" data-testid="nav-home"
                         aria-current="@Current("/")">@Localizer["Nav_Home"]</NavLink>
            </li>
            <li class="nav-item">
                <NavLink class="nav-link" href="/shelf" data-testid="nav-shelf"
                         aria-current="@Current("/shelf")">@Localizer["Nav_Shelf"]</NavLink>
            </li>
            <li class="nav-item">
                <NavLink class="nav-link" href="/cocktails" data-testid="nav-cocktails"
                         aria-current="@Current("/cocktails")">@Localizer["Nav_Cocktails"]</NavLink>
            </li>
        </ul>

        <div class="collapse navbar-collapse @(_menuOpen ? "show" : "")">
            <div class="header-user d-flex flex-column flex-lg-row align-items-lg-center gap-2 gap-lg-3 mt-3 mt-lg-0 pb-2 pb-lg-0">
                <div class="d-flex align-items-center gap-2">
                    <span class="tenant-badge" data-testid="tenant-badge">@Auth.TenantName</span>
                    <span class="user-name text-white-50 small">@Auth.DisplayName</span>
                </div>
                <ThemeSwitcher />
                <NotificationBell />
                @if (_isStaff && !Auth.IsImpersonating)
                {
                    <NavLink class="btn btn-outline-warning btn-sm" href="/admin" data-testid="nav-admin">@Localizer["Nav_Admin"]</NavLink>
                }
                <NavLink class="btn btn-outline-light btn-sm" href="/household">@Localizer["Nav_Household"]</NavLink>
                <NavLink class="btn btn-outline-light btn-sm" href="/billing" data-testid="nav-billing">@Localizer["Nav_Billing"]</NavLink>
                <NavLink class="btn btn-outline-light btn-sm" href="/settings">@Localizer["Nav_Settings"]</NavLink>
                <button class="btn btn-outline-light btn-sm" data-testid="sign-out" @onclick="SignOutAsync">@Localizer["Nav_SignOut"]</button>
            </div>
        </div>

    </div>
</nav>

@code {
    private bool _menuOpen;
    private bool _isStaff;

    // Close the menu after any navigation so it doesn't stay open over the new page on mobile.
    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        // Impersonation swaps the active token in place (a soft nav, no parameter change), so this
        // parameterless component wouldn't otherwise re-render — re-source identity + staff flag then.
        Auth.IdentityChanged += OnIdentityChanged;
    }

    // Show the Admin link only for platform staff (cheap, cached probe). Hidden while impersonating.
    protected override async Task OnInitializedAsync() => _isStaff = await Auth.IsStaffAsync();

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        // Always re-render, not only to close the menu: SHELL-1's aria-current is computed from the
        // location here, and NavLink refreshes its own `active` class without telling its parent — so
        // an early return would leave the tab bar announcing the previous page indefinitely.
        _menuOpen = false;
        InvokeAsync(StateHasChanged);
    }

    // Identity changed under us (enter/leave impersonation): re-probe staff status and re-render so the
    // tenant badge, name, and Admin-link visibility reflect the active token — not the staff cold-start.
    private async void OnIdentityChanged()
    {
        try
        {
            var isStaff = await Auth.IsStaffAsync();
            await InvokeAsync(() =>
            {
                _isStaff = isStaff;
                StateHasChanged();
            });
        }
        catch { /* best-effort — leaves the prior header until the next render */ }
    }

    private void ToggleMenu() => _menuOpen = !_menuOpen;

    /// <summary>
    /// "page" for the destination currently being viewed, null for the rest — Blazor drops an
    /// attribute whose value is null, so the others render nothing at all.
    /// </summary>
    /// <remarks>
    /// <c>NavLink</c> supplies the <c>active</c> CLASS and nothing else, and a tab bar whose current
    /// tab is conveyed by styling alone tells a screen reader nothing. Matching by hand for three
    /// known routes rather than reaching into NavLink: the routes are fixed, and the alternative is
    /// re-deriving what the component is already doing behind its own API.
    /// </remarks>
    private string? Current(string path)
    {
        var relative = "/" + Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].TrimEnd('/');

        var match = path == "/"
            ? relative == "/"                                        // home matches exactly, or "" wins everywhere
            : relative == path || relative.StartsWith(path + "/", StringComparison.Ordinal);

        return match ? "page" : null;
    }

    private async Task SignOutAsync()
    {
        await Auth.LogoutAsync();
        Nav.NavigateTo("/login", forceLoad: true);
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        Auth.IdentityChanged -= OnIdentityChanged;
    }
}
