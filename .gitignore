# Local dev environment — never commit secrets.
# `.env` alone does NOT match names like `jiggerjot-staging.env`, so match any *.env too
# (`.env.example` is unaffected — it ends in .example — and stays committed).
.env
*.env

# .NET build output
bin/
obj/

# User-specific VS/Rider files
*.user
.vs/
.idea/

# Agent / editor tooling
.claude/

# OS
.DS_Store
Thumbs.db

# Node (the Android native smoke in tests/native-smoke-android)
node_modules/

# MAUI lockfile — excluded by design (NATIVE-1): platform-conditional restore makes it churn
src/Maui/packages.lock.json

# VS Code: launch.json + tasks.json are shared (F5 API + Web, Android tasks); per-user preferences stay local
.vscode/settings.json

# Native installables (DEPLOYMENT §9 publishes to out/android and out/windows)
out/

# Raw seed source material — scans and PDFs, which run past GitHub's 100 MB file limit.
# Nothing lives here today (JJ-032 dropped the two books that did); the rule stays so the next
# large source lands somewhere sensible instead of in a commit.
seed/sources/

# Python bytecode from the seed extraction scripts
__pycache__/
*.pyc
